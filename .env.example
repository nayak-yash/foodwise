POSTGRES_PASSWORD=restaurantops-local
MANAGER_API_TOKEN=local-manager-change-me
AGENT_API_TOKEN=local-agent-change-me
DASHBOARD_USERNAME=manager
DASHBOARD_PASSWORD=restaurantops
# Optional: model-assisted diagnosis. Empty uses the deterministic evidence engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# fastembed downloads a small local embedding model on first use.
# Set lexical for offline PostgreSQL full-text retrieval.
RETRIEVAL_MODE=fastembed
